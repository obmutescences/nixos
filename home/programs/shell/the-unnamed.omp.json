{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "blue",
          "properties": {
            "style": "folder"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "red",
          "powerline_symbol": "",
          "properties": {
            "branch_icon": " ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "yellow",
          "style": "plain",
          "template": "<white>is</>  {{.Version}} ",
          "type": "project"
        },
        {
          "foreground": "magenta",
          "properties": {
            "fetch_version": true
          },
          "style": "plain",
          "template": "<white>via</>  {{ .Full }} ",
          "type": "node"
        },
        {
          "foreground": "lightYellow",
          "style": "plain",
          "template": "<white>and</>  {{.Full}} ",
          "type": "npm"
        },
        {
          "foreground": "cyan",
          "style": "plain",
          "template": "<white>via</>  {{.Full}} ",
          "type": "python",
          "properties": {
            "fetch_version": true,
            "fetch_virtual_env": true
          }
        },
        {
          "foreground": "lightGreen",
          "style": "plain",
          "template": "<white>via</>  {{.Full}} ",
          "type": "go",
          "properties": {
            "fetch_version": true
          }
        },
        {
          "foreground": "lightYellow",
          "style": "plain",
          "template": "<white>via</>  {{.Full}} ",
          "type": "rust",
          "properties": {
            "fetch_version": true
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "yellow",
          "style": "plain",
          "template": "❯ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 3
}
