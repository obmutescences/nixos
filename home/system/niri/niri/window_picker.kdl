window-picker {
    // Maximum portion of the active output used by the centered window grid.
    area-width 0.8
    area-height 0.8
    max-scale 0.7
    gap 30

    label {
        font "Sans Bold"
        size 15
        text-color "hsla(60, 90%, 30%, 0.7)"
        background-color "#161a22e6"
        border-color "hsla(60, 90%, 30%, 0.7)"
        padding-x 14
        padding-y 7
        gap 12
        corner-radius 12
    }

    // These effects apply to the desktop as a whole; previews and labels stay sharp.
    backdrop {
        brightness 1.0
        color "#10131a33"
        saturation 1.2

        blur {
            on
            passes 3
            offset 3
        }
    }

	animation-ms-open 220
	animation-ms-close 110
}
