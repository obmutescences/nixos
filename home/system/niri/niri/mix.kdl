layout {
    gaps 15
    center-focused-column "always"
	always-center-single-column
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    default-column-width {
        proportion 0.4
    }
    focus-ring {
        off
        width 0
    }
    border {
		off
        width 0

    }
    shadow {
		// on
		off
        draw-behind-window true
        softness 20
        spread 10
        offset x=0 y=5
		color "#dfb049"
    }

	struts {
		top 35
		right 0
		bottom 0
		left 0
	}


	focus-animation {
	// Uncomment this line to enable focus animation.
	on

	// Animation configuration for the focus animation.
	// Supports easing (duration-ms + curve) or spring.
	// duration-ms 200

	// < 1.0
	spring damping-ratio=0.5 stiffness=1400 epsilon=0.0001

	// > 1.0
	// spring damping-ratio=0.5 stiffness=900 epsilon=0.0001

	scale {
		// Uncomment this line to enable scale flash.
		on

		// Scale factor to flash to when window gains focus.
		// 1.0 is normal size, < 1.0 is shrinking, > 1.0 is expanding.
		// flash-scale 1.7
		flash-scale 0.75

		// Disable focus animation when there's only one window.
		disable-on-solo false

		disable-on-floating true
		}
	}
}

window-rule {
    match is-active=false
    opacity 0.7
	shadow {
			on
			softness 0
			spread 0
			offset x=0 y=0
			draw-behind-window false
			inactive-color "hsla(41, 90%, 45%, 0.3)"
	}
}

window-rule {
    // Replace the old border-color tint with a two-color glass gradient.
    // The window opacity above/below still applies; tint adds its own panel color.
    draw-border-with-background false

    background-effect {
        tint {
            from "hsla(74, 86%, 64%, 0.8)"
            to "hsla(41, 70%, 58%, 0.8)"
            angle 1
            mode "linear" // linear | radial
            opacity 0.4
            linear-size 0.1    // solid start color along 20% of the axis
            linear-depth 0.8   // start color alpha multiplier (0..1)
            radial-size 0.4   // solid center color out to 35% of the radius
            radial-depth 0.9   // center color alpha multiplier (0..1)
        }

        liquid-glass {
            // 0 keeps the existing relative bevel-width tuning.
            bevel-px 20
            rim-color "hsla(41, 70%, 58%, 0.8)"
            rim-strength 1.0
            edge-lighting 10.0
            inner-shadow 0.7
            sheen-color "hsla(74, 86%, 64%, 0.8)"
            sheen-strength 0.0
        }
    }
}


window-picker {
    // Maximum portion of the active output used by the centered window grid.
    area-width 0.8
    area-height 0.8
    max-scale 0.25
    gap 30

    label {
		letters "ASDFXCREWQ"
        font "Comic Code"
        size 15
        text-color "#dfb049"
        background-color "hsla(41, 90%, 10%, 0.3)"
        border-color "#dfb049"
        padding-x 14
        padding-y 7
        gap 12
        corner-radius 12
        // letters "ASDFGHJKL" // if fewer than windows, two-letter random labels
    }

    // These effects apply to the desktop as a whole; previews and labels stay sharp.
    backdrop {
        brightness 1.0
        color "#10131a33"
        saturation 1.2

        blur {
            on
            passes 2
            offset 2
        }
    }

	animation-ms-open 220
	animation-ms-close 210

	stagger-ms 800
    animation {
        duration-ms 200
        curve "ease-out-quad"            // linear | ease-out-quad | ease-out-expo
    }

    // New card layout: window preview fills the card width, app metadata sits
    // below it inside the same rounded glass background.
    card {
        corner-radius 20
        shadow true

        info {
            font "Comic Code"
            title-size 13.5
            app-id-size 16
            workspace-size 10
            title-color "#dfb049"
            app-id-color "#cef254d0"
            workspace-color "#cef254d0"
            padding-x 5
            padding-y 10
            height 58
        }

        // Per-card blur. Lower passes or turn off at 4K if it costs too much.
        blur {
            on
            passes 4
            offset 4
        }
    }

    // pop | slide | drop | burst | vortex | flip | cascade | orbit | wave | zoom | cycle
    // cycle walks the ten styles in order, one per card, continuing across openings.
    motion {
        style "cycle"
    }

	selection {
		focused-color "#cef254"
		hover-color "#cef254"
		glow true      // false 关闭光晕
    }
}

overview {
	backdrop-color "hsla(41, 90%, 10%, 0.3)"
}
